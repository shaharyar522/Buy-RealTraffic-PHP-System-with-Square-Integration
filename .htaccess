RewriteCond %{HTTP_HOST} buy-realtraffic\.com [NC]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://buy-realtraffic.com/$1 [R,L]

<Files 403.shtml>
order allow,deny
allow from all
</Files>

